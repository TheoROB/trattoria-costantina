{
  "name": "trattoria-costantina",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.6.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --project integration",
    "db:up": "docker compose up -d db",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mts",
    "admin:user": "node --env-file-if-exists=.env.local scripts/admin-user.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "mysql2": "3.24.5",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "server-only": "0.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
