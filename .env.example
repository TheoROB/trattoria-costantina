# Copy to .env.local for development. In production, set these in hPanel (never commit real values).
# Special characters in the password must be URL-encoded.
DATABASE_URL=mysql://trattoria:trattoria-dev-only@127.0.0.1:3307/trattoria

# Integration / e2e tests only (database is wiped by the tests).
DATABASE_URL_TEST=mysql://trattoria:trattoria-dev-only@127.0.0.1:3307/trattoria_test

# Admin authentication (docs/adr/0001-admin-authentication.md). At least 32 characters, otherwise login is disabled.
# Generate with: openssl rand -base64 48
AUTH_HMAC_SECRET=
# Stable key shared by every Node process (Hostinger may run several). Embedded by `next build`: set it before
# building. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Public origin of the site, required for photo uploads (CSRF check). Development: http://localhost:3000
APP_ORIGIN=https://trattoriacostantina.fr

# Menu photos (absolute path outside the application, never public/, .next/ or hbuilds/).
# Production: /home/<user>/domains/<domain>/trattoria-media. Development: e.g. /tmp/trattoria-media-dev
MEDIA_ROOT=

# Optional: proxy header holding the client IP. Leave empty until a header is formally verified as not client-controllable
# on Hostinger (empty: only global rate limits apply).
AUTH_TRUSTED_IP_HEADER=

# Contact form (plain-text e-mails via SMTP). Without these the form shows a "call us" message.
# Hostinger: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465 (implicit TLS). Port 587 needs SMTP_SECURE=false (STARTTLS then required).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Optional, defaults to true on port 465 and false otherwise.
SMTP_SECURE=
# Mailbox created in hPanel > Emails (e.g. contact@<domain>) and its password. Secret: never commit it.
SMTP_USER=
SMTP_PASSWORD=
# Sender address: must be exactly SMTP_USER (the authenticated mailbox), otherwise Hostinger rejects it or it lands in spam.
CONTACT_FROM=
# Recipient, required (no fallback). Production: trattoria.costantina@gmail.com. The visitor's address is only set as Reply-To.
CONTACT_TO=
