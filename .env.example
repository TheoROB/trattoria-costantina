# Copy to .env.local for development. In production, set these in hPanel (never commit real values).
# Special characters in the password must be URL-encoded.
DATABASE_URL=mysql://trattoria:trattoria-dev-only@127.0.0.1:3307/trattoria

# Integration / e2e tests only (database is wiped by the tests).
DATABASE_URL_TEST=mysql://trattoria:trattoria-dev-only@127.0.0.1:3307/trattoria_test

# Admin authentication (docs/adr/0001-admin-authentication.md). At least 32 characters, otherwise login is disabled.
# Generate with: openssl rand -base64 48
AUTH_HMAC_SECRET=
# Stable key shared by every Node process (Hostinger may run several). Embedded by `next build`: set it before
# building. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Public origin of the site, required for photo uploads (CSRF check). Development: http://localhost:3000
APP_ORIGIN=https://trattoriacostantina.fr

# Menu photos (absolute path outside the application, never public/, .next/ or hbuilds/).
# Production: /home/<user>/domains/<domain>/trattoria-media. Development: e.g. /tmp/trattoria-media-dev
MEDIA_ROOT=

# Optional: proxy header holding the client IP. Leave empty until a header is formally verified as not client-controllable
# on Hostinger (empty: only global rate limits apply).
AUTH_TRUSTED_IP_HEADER=

# Contact form (plain-text e-mails sent through the Resend API). Without these the form shows a "call us" message.
# Resend API key (resend.com > API Keys, "Sending access" restricted to trattoriacostantina.fr). Secret: set it in hPanel only,
# never commit it.
RESEND_API_KEY=
# Sender on the domain verified at Resend (SPF/DKIM). "Name <address>" or a bare address.
CONTACT_FROM=Trattoria Costantina <site@trattoriacostantina.fr>
# Recipient, required (no fallback). The visitor's address is only set as Reply-To.
CONTACT_TO=trattoria.costantina@gmail.com
# Tests only: points the form at a local Resend double (http://127.0.0.1:<port> or localhost; any other host disables
# the form). Leave unset in production.
# RESEND_BASE_URL=

# Anti-spam for the contact form: reCAPTCHA Enterprise with a score-based key (Google Cloud console > Security >
# reCAPTCHA / Fraud Defense, domain trattoriacostantina.fr). Leave all three empty to run the form without reCAPTCHA
# (development, tests); setting only some of them disables the form.
# Public site key, embedded by `next build`: set it before building (changing it needs a rebuild).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Google Cloud project ID that owns the key (e.g. trattoria-costantina-123456).
RECAPTCHA_PROJECT_ID=
# Google Cloud API key restricted to the reCAPTCHA Enterprise API (APIs & Services > Credentials). Secret: set it in
# hPanel only, never commit it.
RECAPTCHA_API_KEY=
# Optional: minimum score between 0 (bot) and 1 (human) for a message to be sent. Default: 0.5.
# RECAPTCHA_MIN_SCORE=
# Tests only: points the assessments at a local double (http://127.0.0.1:<port> or localhost; any other host disables
# the form). Leave unset in production.
# RECAPTCHA_API_BASE_URL=
